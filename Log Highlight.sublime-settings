{
    "auto_highlight" : true,
    "log_list": {
        "Logcat (compact)": {
            "type": "compile",
            "extension": "*.log",
            "use_link"     : true,
            "search_base": {
                "enable": true,
            },
            "bookmark": {
                "enable": true,
                "goto_error": false,
            },
            "severity": {
                "error": {
                    "enable": true,
                    "pattern": [ 
                        // [ "begin regex", "end regex" ] or [ "match regex", "" ]
                        [ "^.*\\s{2}E\\s{2}", "[\\r\\n]" ],
                        [ "^\\s{20,}.*(Exception|Throwable).*", "^(?=\\S)" ], // TODO Handle stacktraces better
                    ],
                    "color": {
                        // ["foreground", "background"]
                        "base": ["#F92672", ""],
                        "link": ["#E6DB74", ""],
                        "quote": ["#4F99D3", ""],
                    },
                    "icon": "Danish Royalty/error.png",
                },
                "warning": {
                    "enable": true,
                    "pattern": [ 
                        // [ "begin regex", "end regex" ] or [ "match regex", "" ]
                        [ "^.*\\s{2}W\\s{2}", "[\\r\\n]" ],
                    ],
                    "color": {
                        // ["foreground", "background"]
                        "base": ["#A1B347", ""],
                        "link": ["#FD971F", ""],
                        "quote": ["#4F99D3", ""],
                    },
                    "icon": "Danish Royalty/warning.png",
                }
            },
            "theme": {
                "foreground": "#D7D7D7",
                "caret": "#F29718",
                "selection": "#3A5166",
                "selectionBorder": "#181E26",
                "lineHighlight": "#283240",
            }
        }
    } 
}